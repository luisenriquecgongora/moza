# GitHub Linguist Language Detection Configuration
# Establishes Python as the Primary Language for Moza

# Mark documentation and test suites
**/*.test.py linguist-documentation
tests/** linguist-documentation
docs/** linguist-documentation

# Primary Python library and service detection
src/moza/**/*.py linguist-detectable=true
src/moza/**/*.py linguist-language=Python
services/**/*.py linguist-detectable=true
services/**/*.py linguist-language=Python
clients/**/*.py linguist-detectable=true

# Consistent line endings across operating systems
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Large models, binaries, and generated weights
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text

# Collapse lockfiles and build outputs in PRs and git diffs
*lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
dist/** linguist-generated=true
build/** linguist-generated=true
out/** linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
